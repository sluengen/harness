# harness build context exclusions.
# Keep the image small and reproducible: only the runtime sources listed in the
# Dockerfile (pyproject.toml, uv.lock, README.md, harness/, workflows/, prompts/)
# should ever end up in a layer.

# Virtualenvs / caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Tests + fixtures — not shipped in the runtime image.
tests/

# VCS metadata + worktrees — both large and would invalidate the layer cache.
.git/
.gitignore
.worktrees/

# Harness state + databases (per-run, host-only)
.harness/
*.db
*.db-shm
*.db-wal

# Build / dist artefacts
build/
dist/

# Editor + OS
.vscode/
.idea/
.DS_Store

# Project metadata not needed at runtime
.claude/
.github/
docs/
examples/
contracts/
scripts/
SPEC.md
CLAUDE.md

# The Dockerfile itself doesn't belong inside the image, but the entrypoint
# dispatch script (decision #3 — one image, two entrypoints) is COPYed in, so
# re-include just that one file from the otherwise-excluded docker/ tree.
docker/
!docker/entrypoint.sh
