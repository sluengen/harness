# harness build context exclusions.
# Keep the image small and reproducible: only the runtime sources listed in the
# Dockerfile (pyproject.toml, uv.lock, README.md, harness/, workflows/, prompts/)
# should ever end up in a layer.

# Virtualenvs / caches
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Tests + fixtures — not shipped in the runtime image.
tests/

# VCS metadata + worktrees — both large and would invalidate the layer cache.
.git/
.gitignore
.worktrees/

# Harness state + databases (per-run, host-only)
.harness/
*.db
*.db-shm
*.db-wal

# Build / dist artefacts
build/
dist/

# Editor + OS
.vscode/
.idea/
.DS_Store

# Project metadata not needed at runtime
.claude/
.github/
docs/
examples/
contracts/
scripts/
SPEC.md
CLAUDE.md

# The Dockerfile itself doesn't belong inside the image, but three files from
# docker/ are COPYed in and are re-included from the otherwise-excluded tree: the
# entrypoint (which dispatches the `verb` and `install` roles), the installer it
# runs for `install`, and the versioned client that installer emits (#312).
# Exclude the *contents* (docker/*), not the parent directory: excluding the
# directory itself stops the classic builder descending into it, so the
# re-includes would never take effect.
docker/*
!docker/entrypoint.sh
!docker/install-client.sh
!docker/harness-wrapper.sh
