# No trailing slash: the worktree-isolation flow links each workspace's
# dependencies in from one shared install (`ln -sfn "$SHARED_ROOT/node_modules"`),
# so in every agent worktree node_modules and frontend/node_modules are symlinks.
# A directory-only pattern cannot match one — git reads directory-ness from disk
# — so until ERP-351 `git add -A` staged both, including the `add -A` that
# scripts/gate/gate-marker.js builds the gated tree oid from.
node_modules

# holds LINEAR_API_KEY and app secrets — keep every variant out of git
.env
.env.*
!.env.example
coverage/
dist/
*.lcov

# local virtualenv (a native `uv tool install` of the harness)
.venv/

# Harness local run ledger (SQLite) — per-machine execution state, never committed
.harness/

# Harness verb scratch at the repo root — a `harness review` needs its
# --gate-log/--design-file paths inside the repo mount, so those files land
# here rather than in /tmp. They are per-run artefacts, not source. Six of them
# reached `dev` in 104a70e via a `git add -A` that swept them up.
/.harness-*

# Worktree-isolation checkouts — per-machine working branches, never committed
.worktrees/

# The process guidance ships as the `harness` Claude Code plugin, not as copied
# trees in this repo, so .claude/ is tracked: settings.json and hooks/ are this
# repo's own committed configuration. (.claude/hooks/ used to be ignored because
# it was a symlink to a copied guidance tree; it is now a real directory holding
# this repo's own SessionStart hook and must be committed.) Exactly two subtrees
# are excluded, and neither may be widened to a blanket .claude/ rule without
# un-tracking that configuration:
#
#  - per-machine Claude Code overrides, which are local by definition;
#  - .claude/worktrees/, where Claude Code's `isolation: worktree` checks a
#    sub-agent out. It is the agent runner's equivalent of .worktrees/ above and
#    is excluded for the same reason: each entry is a registered git worktree
#    holding a full checkout plus a .git file. Tracked by omission until ERP-349,
#    it sat in `git status` as untracked for as long as a sub-agent ran, where
#    the session Stop hook advises committing it and a `git add -A` would.
.claude/settings.local.json
.claude/worktrees/

# Gate evidence the harness plugin writes beside a repo that has no gate of its
# own. This repo writes its marker into the git directory instead, but the
# plugin's convention costs nothing to honour.
.evidence/

# The frontend lint fixture (ERP-331). test/frontend_lint_contract.test.ts
# builds a copy of the frontend TypeScript project here and plants real defects
# in it. It has to live in the repo — Oxlint's type-aware backend finds
# `oxlint-tsgolint` by walking up from the working directory — and it has to be
# invisible to git, because `node --test` runs files in parallel and
# test/gate_marker.test.ts asserts over `git status` and a `git add -A` tree oid
# while it exists. This line is what lets both hold.
/.frontend-lint-fixture-*/

# The Oxlint contract fixture (ERP-380). test/tooling_contract.test.ts writes a
# file carrying every violation the root .oxlintrc.json must reject, runs Oxlint
# over it, and deletes it. It has to live in the repo for the reason above —
# Oxlint's type-aware backend finds `oxlint-tsgolint` by walking up from the
# working directory — and it has to be invisible to git, because `node --test`
# runs files in parallel while scripts/gate/gate-marker.js#currentTree() computes the
# gated tree oid from a `git add -A` over this same root. Un-ignored, the file
# existed for part of that staging run and was gone by the end of it: `add -A`
# either failed to stat it or staged it into the oid the marker certifies.
# test/root_fixture_ignore.test.ts holds this rule and its neighbours to that
# property, over the root-anchored paths a test source builds from a literal
# `join(ROOT, …)`; that scan's own docstring states what it cannot see.
/test/.lint-contract-fixture.ts

# The containment probe's refusal target (ERP-457). test/support/containmentProbe.ts
# attempts one real directory creation at the repository root inside a process
# that must refuse it, which is what proves the containment is real rather than
# asserted. The name is deliberately not one of the retired-guidance paths, so a
# containment that ever went missing leaves an inert directory rather than racing
# test/agent_guidance_contract.test.ts — and this rule keeps that directory
# invisible to the `git add -A` scripts/gate/gate-marker.js#currentTree() runs.
/.containment-probe-*/
