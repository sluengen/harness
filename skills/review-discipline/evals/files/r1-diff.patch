+/**
+ * done — publish the gate record for the landed tree and advance the
+ * green pointer so the next builder branches off a commit known green.
+ */
+function done(args) {
+  const tree = git(['rev-parse', 'HEAD^{tree}']);
+  writeGateRecord(tree);
+
+  // The green pointer lives on the remote, so publishing it is a push.
+  execFileSync('git', ['push', 'origin', `HEAD:refs/harness/green`], {
+    stdio: 'inherit',
+  });
+
+  advanceGreenPointer(tree);
+  return 0;
+}
+
