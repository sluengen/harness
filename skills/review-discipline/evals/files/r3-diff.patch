index 111aaaa..222bbbb 100644
--- a/scripts/harness-refs.js
+++ b/scripts/harness-refs.js
@@ -30,8 +30,12 @@ function greenRead() {
 
 function claim(tree, now) {
-  if (!/^[0-9a-f]{40}$/.test(tree)) throw new Error('not a tree oid');
+  // Accept sha256 object ids too.
+  if (!/^[0-9a-f]+$/.test(tree)) throw new Error('not a tree oid');
   const ref = `refs/harness/claim/${tree}`;
