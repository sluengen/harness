{
  "permissions": {
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(*)",
      "Bash(git push origin dev)",
      "Bash(git push origin HEAD:dev)",
      "Bash(git push origin *:dev)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue create *)",
      "Bash(gh issue close *)",
      "Bash(gh project item-add *)",
      "Bash(gh project item-edit *)",
      "Bash(git branch -d *)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "Skill(claude-api)",
      "Skill(claude-api:*)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push * --force *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push * --force-with-lease *)",
      "Bash(git -C * push --force *)",
      "Bash(git -C * push * --force *)",
      "Bash(git -C * push --force-with-lease *)",
      "Bash(git -C * push * --force-with-lease *)",
      "Bash(git push * +*)",
      "Bash(git push origin +*)",
      "Bash(git -C * push * +*)",
      "Bash(git reset --hard *)",
      "Bash(git -C * reset --hard *)",
      "Bash(git merge * main)",
      "Bash(git merge * main *)",
      "Bash(git -C * merge * main)",
      "Bash(git -C * merge * main *)",
      "Bash(gh pr merge *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/test-lock-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/prompt-guard.js"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/workflow-guard.js"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/push-target-guard.js"
          }
        ]
      }
    ]
  }
}
