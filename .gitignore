# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
!prompts/build/
dist/
.venv
.venv/
venv
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage
.coverage
.coverage.*
htmlcov/

# Env / secrets
.env
.env.*

# uv
# uv.lock is committed — it pins the dev toolchain the gate runs on, so a fresh
# checkout resolves the same ruff/mypy/pytest every other checkout did.

# State / artifacts
.harness/
*.db
*.db-shm
*.db-wal

# Worktrees
# .worktrees/ is where a task is isolated (`worktree-isolation`);
# .claude/worktrees/ is the Claude Code CLI's agent-dispatch root — different
# owner, same hazard. Keep comments on their own lines: git does not treat a
# trailing '#' on a pattern line as a comment.
.worktrees/
.claude/worktrees/

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Claude Code local
.claude/settings.local.json
.claude/scheduled_tasks.lock

# .codex/ and .gemini/ are committed like .claude/ in this committed-mode repo.
# Ignore only genuinely per-machine bits if any appear (e.g. an absolute-path hook config).

# Working artifacts a task stages at the worktree root. Not covered by
# `.harness/` above — both land at the root.
#   gate.log   — captured verify-gate output, kept for a review to read
#   /design.md — the design stage's artifact on a complex run
# `design.md` is root-anchored: it is a name worth tracking under docs/ or
# specs/, unlike the distinctive `gate.log`.
gate.log
/design.md
