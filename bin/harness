#!/usr/bin/env bash
# bin/harness — DEV-TIME WORKAROUND ONLY.
#
# This script is a convenience shim for running the harness from inside the
# harness repo checkout during development. It is NOT the production entry
# point.
#
# Production / cross-repo usage:
#   - Native install: `uv tool install .` from the repo root, then run the
#     `harness` console script that uv places on PATH. Workflows are bundled
#     as package data and resolved automatically.
#   - Container: `docker run --rm -v $(pwd):/workspace harness:dev run <wf>`.
#     See docker/README.md for the thin shell wrapper pattern.
#
# Why this script exists:
#   When VIRTUAL_ENV points at a foreign Python installation (e.g. a
#   Homebrew-managed venv active in the outer shell), `uv run harness` either
#   fails silently with ModuleNotFoundError or emits:
#
#     warning: `VIRTUAL_ENV=...` does not match the project environment path
#     `.venv` and will be ignored
#
#   Fix: unset VIRTUAL_ENV, then invoke .venv/bin/python directly. This is
#   identical to the confirmed workaround `.venv/bin/python -m harness.cli`
#   but packaged as a named entry-point so callers don't need to know the path.
#
# Usage (dev only, from repo root): bin/harness [harness CLI args...]
set -euo pipefail

# Resolve project root (the directory containing this script's parent).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Drop any inherited VIRTUAL_ENV — the .venv below is always the right one.
unset VIRTUAL_ENV

exec "$ROOT/.venv/bin/python" -m harness.cli "$@"
