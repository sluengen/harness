#!/bin/bash
# Post-commit hook: regenerate Markdown views whenever manifest.yaml changes.
#
# This is the committed source. To install:
#   cp scripts/hooks/post-commit .git/hooks/post-commit
#   chmod +x .git/hooks/post-commit

if git show --stat HEAD | grep -q "manifest.yaml"; then
    cd "$(git rev-parse --show-toplevel)" || exit 1
    echo "manifest.yaml changed — regenerating Markdown views..."
    python3 scripts/manifest_to_md.py
fi
